# App
APP_ENV=development
PORT=8080
# Comma-separated list of reverse proxy IPs/CIDRs allowed to set X-Forwarded-For.
# Leave empty when the API is reached directly (no proxy in front) so ClientIP()
# cannot be spoofed by an arbitrary client header (S3).
TRUSTED_PROXIES=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openschool
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
# Per-statement timeout in milliseconds; a slow query must not hold a pooled connection indefinitely (S15).
DB_STATEMENT_TIMEOUT_MS=10000

IDP_PROVIDER=thunderid

# ThunderID login and token settings
THUNDERID_JWKS_URL=https://localhost:8090/oauth2/jwks
THUNDERID_ISSUER=https://localhost:8090

THUNDERID_BASE_URL=https://localhost:8090
THUNDERID_OU_ID=01900000-0000-7000-8000-000000000001

THUNDERID_CLIENT_ID=N0000Dbx1111111169oUaA
# if you using setup.sh it  creates this value for you. Do not commit a real secret.
THUNDERID_CLIENT_SECRET=
THUNDERID_TOKEN_URL=https://localhost:8090/oauth2/token

# Role IDs used by OpenSchool
THUNDERID_ROLE_STUDENT=
THUNDERID_ROLE_TEACHER=
THUNDERID_ROLE_ADMIN=
THUNDERID_ROLE_GUARDIAN=

THUNDERID_RESOURCE=https://localhost:8090/mcp

# Encrypts activation codes so admins can reprint unused ones from Settings > Account activation.
# 32 random bytes in base64: openssl rand -base64 32. Leave empty to keep codes as hashes only
# (no reprinting). Changing it later makes codes issued before the change impossible to reprint.
ACTIVATION_CODE_KEY=

# Frontend address used in email links
FRONTEND_URL=http://localhost:5173

# Email settings
# Provider: resend, smtp or console. Left empty, RESEND_API_KEY picks resend,
# SMTP_HOST picks smtp, and nothing picks console (emails go to the server log).
# Production refuses to start with console or with MAIL_REDIRECT_TO set.
MAIL_PROVIDER=
RESEND_API_KEY=
# Sender, with an optional display name. Without a verified domain, Resend only
# allows onboarding@resend.dev and only delivers to your own Resend account email.
MAIL_FROM=OpenSchool <onboarding@resend.dev>
# Optional. Defaults to the school email from Settings > General.
MAIL_REPLY_TO=
# Testing only: send every email to this inbox, with a note saying who it was for.
MAIL_REDIRECT_TO=

# SMTP (also works with Resend: host smtp.resend.com, port 465, username resend,
# password = your Resend API key).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Older sender setting, used when MAIL_FROM is empty.
SMTP_FROM=

# Nightly backup agent (S11)
JOB_BACKUP_DIR=./backups
# age (https://age-encryption.org) X25519 public key ("age1...") the nightly
# dump is encrypted to. Generate a keypair with `age-keygen`, keep the
# private key off this host, and put only the public key here. Leave empty
# to keep backups unencrypted (not recommended beyond local development).
BACKUP_AGE_RECIPIENT=
# A second directory (e.g. a mounted network share) the nightly backup is
# also copied to, so it survives the loss of this host. Leave empty to skip.
BACKUP_OFFSITE_DIR=

# Push notifications (mobile app, ADR 0010)
# The backend only talks to Expo's push gateway; FCM/APNs credentials stay
# inside your Expo account (docs/MOBILE.tr.md section 5.2).
# Master switch: without it no push is sent, the in-app inbox is unaffected.
PUSH_ENABLED=false
# Expo push API endpoint. Example value: https://exp.host/--/api/v2/push/send
# Override only for tests or staging.
EXPO_PUSH_BASE_URL=https://exp.host/--/api/v2/push/send
# Access token from expo.dev (Account settings > Access tokens). Optional on
# the free tier, recommended in production; never commit the real value.
EXPO_PUSH_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Platform (control plane, cmd/platform) — docs/adr/0011
# The SaaS layer is its own deployment + database; leave everything below
# empty on school instances.
# ─────────────────────────────────────────────────────────────────────────────
# Control plane API port.
PLATFORM_PORT=8090
# Platform database (separate from the school DB_* above).
PLATFORM_DB_HOST=localhost
PLATFORM_DB_PORT=5432
PLATFORM_DB_NAME=openschool_platform
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=postgres
PLATFORM_DB_SSLMODE=disable
# HS256 session secret for platform users. 32+ random bytes:
#   openssl rand -hex 32
PLATFORM_JWT_SECRET=
# Where the platform frontend lives (links in emails, CORS).
PLATFORM_FRONTEND_URL=http://localhost:5174
# Public address of this API (iyzico posts the checkout result here).
PLATFORM_BACKEND_URL=http://localhost:8090
# First super-admin of the control plane; created on first start only.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# iyzico payment integration (docs/adr/0012)
# mock: fully offline state machine (development/CI) — the default without
#       credentials. sandbox/live: real iyzico endpoints.
IYZICO_MODE=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Monthly auto-renewal runs on iyzico's Subscription API: create the product
# + pricing plan in the merchant panel, then map it per plan code.
IYZICO_PP_BASLANGIC_MONTHLY=
IYZICO_PP_STANDART_MONTHLY=
IYZICO_PP_KURUMSAL_MONTHLY=
