# OpenSchool API base (backend .env PORT + /api/v1)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# ThunderID OIDC (public client — authorization code + PKCE)
EXPO_PUBLIC_THUNDERID_ISSUER=https://localhost:8090
EXPO_PUBLIC_THUNDERID_CLIENT_ID=
# Space separated; the app requests the same claim scopes as the web frontend
EXPO_PUBLIC_THUNDERID_SCOPES=openid profile email roles phone

# Custom-scheme redirect for standalone builds (register the same URI in ThunderID)
EXPO_PUBLIC_OAUTH_REDIRECT_SCHEME=openschool
EXPO_PUBLIC_OAUTH_REDIRECT_PATH=oauth2redirect
